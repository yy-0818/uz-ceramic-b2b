{
  "name": "uz-ceramic-b2b",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --ext .ts,.tsx,.vue",
    "lint:fix": "eslint . --ext .ts,.tsx,.vue --fix",
    "lint:check": "eslint . --ext .ts,.tsx,.vue --max-warnings=999",
    "format": "prettier --write \"src/**/*.{ts,tsx,vue,css}\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,vue,css}\" \"tests/**/*.ts\"",
    "i18n:check": "node scripts/check-i18n.mjs",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:install": "playwright install --with-deps chromium",
    "prepare": "husky || true"
  },
  "lint-staged": {
    "*.{ts,tsx,vue,css}": [
      "prettier --write",
      "eslint --fix"
    ]
  },
  "dependencies": {
    "@sentry/vue": "^9.47.1",
    "@supabase/supabase-js": "^2.45.4",
    "@vueuse/core": "^11.1.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "jszip": "^3.10.1",
    "lucide-vue-next": "^0.460.0",
    "papaparse": "^5.4.1",
    "pinia": "^2.2.4",
    "radix-vue": "^1.9.7",
    "tailwind-merge": "^2.5.2",
    "vue": "^3.5.10",
    "vue-router": "^4.4.5",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.7.4",
    "@types/papaparse": "^5.3.14",
    "@vitejs/plugin-vue": "^5.1.4",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.4.11",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.9.0",
    "happy-dom": "^20.11.1",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "postcss": "^8.4.47",
    "prettier": "^3.9.6",
    "tailwindcss": "^3.4.13",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.66.0",
    "vite": "^5.4.8",
    "vitest": "^4.1.10",
    "vue-tsc": "^2.1.6"
  },
  "overrides": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5"
  }
}
