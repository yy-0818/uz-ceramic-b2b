# Frontend env (Vite exposes only VITE_*-prefixed vars to the browser bundle)
VITE_SUPABASE_URL=https://<your-project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<your-anon-key>

# Edge Functions URL —— 客户登录、邀请、重置密码、共用
# 部署完 3 个 function 后填这个值
# 格式：https://<project-ref>.supabase.co/functions/v1
# 在 Vercel dashboard 的环境变量里加 VITE_SUPABASE_FUNCTIONS_URL
VITE_SUPABASE_FUNCTIONS_URL=https://<your-project-ref>.supabase.co/functions/v1

# Optional: Sentry 监控 (DSN 从 sentry.io 项目 settings > Client Keys 拿)
# 留空 = Sentry 全局 noop，不影响功能
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=development

# Server-side ONLY — NEVER expose to the browser / Vercel frontend
# Used for psql, migrations, Edge Functions admin scripts
SUPABASE_SECRET_KEY=<your-secret-key>
SUPABASE_JWKS_URL=https://<your-project-ref>.supabase.co/auth/v1/.well-known/jwks.json