# Template for production environment — commit safely (no secrets here).
#
# On Vercel: paste only VITE_* values into "Production / Preview" environment variables.
# Do NOT paste SUPABASE_SECRET_KEY into Vercel frontend env (it can be read in browser bundle).
#
# For server-side ops (psql, Edge Functions, admin scripts) set SUPABASE_SECRET_KEY
# on your local machine only, never in Vercel.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_FUNCTIONS_URL=https://<your-project-ref>.supabase.co/functions/v1